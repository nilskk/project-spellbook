{
  "manifest_version": 3,
  "name": "Project Spellbook",
  "version": "1.0.0",
  "description": "Enhance the UI of D&D Beyond character tool",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://dndbeyond.com/*",
    "*://www.dndbeyond.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://dndbeyond.com/characters/*",
        "*://www.dndbeyond.com/characters/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://dndbeyond.com/*", "*://www.dndbeyond.com/*"]
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Project Spellbook",
  "version": "1.0.0",
  "description": "Enhance D&D Beyond character tool with pinning and more critical damage calculations.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://dndbeyond.com/*",
    "*://www.dndbeyond.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://dndbeyond.com/characters/*",
        "*://www.dndbeyond.com/characters/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["*://dndbeyond.com/*", "*://www.dndbeyond.com/*"]
    }
  ]
}
